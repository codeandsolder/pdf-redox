+/// Raw dictionary entries in sorted, unique key order.
+pub struct DictEntries<'a> {
+    dictionary: Dict<'a>,
+    small_order: Option<SmallVec<[usize; MAX_UNSORTED_LEN]>>,
+    next: usize,
+}
+
+impl<'a> DictEntries<'a> {
+    fn new(dictionary: Dict<'a>) -> Self {
+        // Large dictionaries are already sorted and deduplicated by the
+        // parser. Small ones retain insertion order and first-key wins.
+        let small_order = (dictionary.len() <= MAX_UNSORTED_LEN).then(|| {
+            let offsets = dictionary.offsets();
+            let mut indices: SmallVec<[usize; MAX_UNSORTED_LEN]> = (0..offsets.len()).collect();
+            indices.sort_by(|&a, &b| offsets[a].0.as_ref().cmp(offsets[b].0.as_ref()));
+            indices.dedup_by(|a, b| offsets[*a].0 == offsets[*b].0);
+            indices
+        });
+        Self {
+            dictionary,
+            small_order,
+            next: 0,
+        }
+    }
+}
+
+impl<'a> Iterator for DictEntries<'a> {
+    type Item = (Name<'a>, MaybeRef<Object<'a>>);
+
+    fn next(&mut self) -> Option<Self::Item> {
+        loop {
+            let index = match &self.small_order {
+                Some(order) => *order.get(self.next)?,
+                None => self.next,
+            };
+            let (name, offset) = self.dictionary.offsets().get(index)?;
+            self.next += 1;
+            if let Some(value) = Reader::new(&self.dictionary.data()[*offset..])
+                .read_with_context::<MaybeRef<Object<'a>>>(self.dictionary.ctx())
+            {
+                return Some((name.clone(), value));
+            }
+        }
+    }
+}
