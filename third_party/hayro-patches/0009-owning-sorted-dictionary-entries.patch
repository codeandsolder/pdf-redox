+    #[test]
+    fn entries_own_the_iterator_and_preserve_small_dictionary_duplicates() {
+        let mut entries = Dict::from_bytes(b"<< /Z 9 /A 1 /A 2 /B 3 >>")
+            .unwrap()
+            .entries();
+        for (expected_key, expected_value) in [(b"A", 1), (b"B", 3), (b"Z", 9)] {
+            let (name, value) = entries.next().unwrap();
+            assert_eq!(name.as_ref(), expected_key);
+            assert!(
+                matches!(value, crate::object::MaybeRef::NotRef(crate::object::Object::Number(number)) if number.as_i64() == expected_value)
+            );
+        }
+        assert!(entries.next().is_none());
+    }
+
+    #[test]
+    fn entries_reuse_large_dictionary_order_and_first_duplicate() {
+        let data = b"<< /Z 9 /A 1 /A 2 /Q 3 /P 4 /O 5 /N 6 /M 7 /L 8 /K 9 /J 10 /I 11 /H 12 /G 13 /F 14 /E 15 /D 16 /C 17 /B 18 >>";
+        let dictionary = Dict::from_bytes(data).unwrap();
+        let mut last = None;
+        let mut count = 0;
+        for (name, value) in dictionary.entries() {
+            assert!(
+                last.as_ref()
+                    .is_none_or(|previous: &Name<'_>| previous.as_ref() < name.as_ref())
+            );
+            if name.as_ref() == b"A" {
+                assert!(
+                    matches!(value, crate::object::MaybeRef::NotRef(crate::object::Object::Number(number)) if number.as_i64() == 1)
+                );
+            }
+            last = Some(name);
+            count += 1;
+        }
+        assert_eq!(count, 18);
+    }
