{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>codeandsolder/ci-workflows:renovate-fleet"
  ],
  "packageRules": [
    {
      "description": "Update crates sharing version-specific Rust types together",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "font-types",
        "read-fonts",
        "write-fonts",
        "skrifa",
        "skera"
      ],
      "groupName": "Fontations crates",
      "groupSlug": "fontations-crates"
    }
  ]
}
